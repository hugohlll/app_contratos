# Configurações do Django
DEBUG=False
SECRET_KEY=TROQUE_ESTA_SENHA_MUITO_SEGURA_E_LONGA
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,seuservidor.om.mil.br

# Configurações que o container Postgres usa para CRIAR o banco
POSTGRES_USER=admin_siscont
POSTGRES_PASSWORD=umasenhaseguraaqui
POSTGRES_DB=siscont_db

# URL que o Django usa para se CONECTAR (deve bater com os valores acima)
# Formato: postgres://USUARIO:SENHA@db:5432/NOME_DO_BANCO
DATABASE_URL=postgres://admin_siscont:umasenhaseguraaqui@db:5432/siscont_db

# E-mail automático pelo SMTP do Intraer (mail.intraer:587, STARTTLS)
# Sem EMAIL_BACKEND o sistema não envia nada (as mensagens só aparecem no log).
EMAIL_BACKEND=contratos.email_backend.IntraerSMTPBackend
EMAIL_HOST=mail.intraer
EMAIL_PORT=587
EMAIL_HOST_USER=scipg.gapbr@fab.mil.br
# Código de aplicativo gerado no FAB Mail (Preferências > Contas > Aplicativos), NÃO a senha.
# Proteja o arquivo: chmod 600 .env.prod. Se o código tiver '$', escreva '$$' (o Docker Compose
# interpreta '$' como variável).
EMAIL_HOST_PASSWORD=COLE_AQUI_O_CODIGO_DE_APLICATIVO
# O remetente padrão (SCIPG - GAP-BR <scipg.gapbr@fab.mil.br>) já vem do settings.py.
